# Copy outside the checkout to $AML_STATE_DIR/run/public.env, chmod 600, and edit.
# These are placeholders. Never commit the populated file.
AML_API_KEY=
DASHSCOPE_API_KEY=
AML_BIND=127.0.0.1
AML_TRIAL_PORT=8443
EMBED_PROVIDER=dashscope
EMBED_DIM=1024
AML_TIME_ORDER=on
AML_NEIGHBOR_TURNS=on
AML_NEIGHBOR_TRUNC=200
AML_NEIGHBOR_MAXLEN=500
AML_MH=off
AML_MH2=off
AML_ABSTAIN_FLOOR=off
# Optional: absolute path to the Python executable in the installed virtualenv.
# AML_PYTHON=/path/to/venv/bin/python
# JEV key: put ONLY its value in $AML_STATE_DIR/secrets/.typesafe_key_aml (chmod 600).
# Fixed profile in shell/serve_exam.py: 16 concurrent calls/search, pool 100.
# Do not add controlled AML_RERANK_* overrides here; start.sh clears those listed there.
